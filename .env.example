# Copie este arquivo para .env e ajuste os valores do seu ambiente.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Banco de dados MySQL
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=digital_store
DB_USER=root
DB_PASSWORD=root

# Autenticação JWT
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=1d
